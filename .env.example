POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-database-password@db:5432/rag
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4.1-mini
ANSWER_ENGINE=legacy
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5
MIN_SIMILARITY=0.25
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WIKI_ALLOWED_HOSTS=wiki.hcmut.edu.vn,bkwiki.hcmut.edu.vn,mybk.hcmut.edu.vn
BKSI_MAX_ARTICLES=100
BKSI_MAX_PAGES=180
WEB_REQUEST_DELAY_SECONDS=0.3
CONFIG_VERSION=baseline-v1

# openai (remote) hoặc ollama (local); script use-local-models.py cấu hình tự động
MODEL_PROVIDER=openai
MODEL_TIMEOUT_SECONDS=300
EMBEDDING_BATCH_SIZE=8
OLLAMA_NUM_CTX=8192
CONTEXT_MAX_CHARS=12000
RETRIEVAL_STRATEGY=vector_keyword
RETRIEVAL_CACHE_SECONDS=600
SOURCE_FRESHNESS_DAYS=30
# Docker Compose uses the durable worker; direct Python/test defaults to background.
JOB_EXECUTION_MODE=background
WORKER_POLL_SECONDS=2
OLLAMA_NUM_GPU=-1
OLLAMA_CPU_FALLBACK=true
